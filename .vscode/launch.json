{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Parse Classic talents",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/parse-talents.py",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"args": [
				"--output", "out/TalentDataClassic.lua",
				"${input:rawTalentFile}",
			]
		},
